{
  "name": "reactvitets",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "eslint": "eslint .",
    "stylelint": "stylelint **/*.css",
    "lint": "pnpm eslint && pnpm stylelint",
    "stylelint:fix": "stylelint **/*.css --fix",
    "preview": "vite preview",
    "prettier": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@responsive-image/react": "^1.1.2",
    "@tailwindcss/vite": "^4.1.11",
    "react": "19.1.2",
    "react-dom": "^19.1.2",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@responsive-image/core": "^2.1.0",
    "@responsive-image/vite-plugin": "^2.0.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "6.0.0-rc1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.7.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "stylelint": "^16.22.0",
    "stylelint-config-clean-order": "^7.0.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-plugin-use-baseline": "^0.9.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.0.5"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{html,md}": "prettier --write"
  }
}
