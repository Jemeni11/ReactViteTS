{
  "extends": ["stylelint-config-standard", "stylelint-config-clean-order"],
  "rules": {
    "color-no-invalid-hex": true,
    "import-notation": "string",
    "value-keyword-case": [
      "lower",
      {
        "camelCaseSvgKeywords": true
      }
    ],
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": ["theme"]
      }
    ]
  }
}
